local Tabs = {
    Main = Window:AddTab("Main", "box"),
    Settings = Window:AddTab("UI Settings", "settings"),
}

local autoWhite = false
local whiteDelay = 0.5
local whiteThread = nil
local autoYellow = false
local yellowDelay = 0.5
local yellowThread = nil
local autoRainbow = false
local rainbowDelay = 0.5
local rainbowThread = nil

local function fireRemote(remoteName)
    local ok, err = pcall(function()
        ReplicatedStorage:WaitForChild(remoteName, 5):FireServer()
    end)
    if not ok then warn("[Grief] 刷取失败 (" .. remoteName .. "): " .. tostring(err)) end
    return ok
end

local function spawnWhite() return fireRemote("SpawnGalaxyBlock") end
local function spawnYellow() return fireRemote("SpawnLuckyBlock") end
local function spawnRainbow() return fireRemote("SpawnRainbowBlock") end

local function startWhite()
    if whiteThread then return end
    whiteThread = task.spawn(function()
        while autoWhite do pcall(spawnWhite); task.wait(whiteDelay) end
        whiteThread = nil
    end)
end
local function stopWhite() autoWhite = false; if whiteThread then task.cancel(whiteThread); whiteThread = nil end end

local function startYellow()
    if yellowThread then return end
    yellowThread = task.spawn(function()
        while autoYellow do pcall(spawnYellow); task.wait(yellowDelay) end
        yellowThread = nil
    end)
end
local function stopYellow() autoYellow = false; if yellowThread then task.cancel(yellowThread); yellowThread = nil end end

local function startRainbow()
    if rainbowThread then return end
    rainbowThread = task.spawn(function()
        while autoRainbow do pcall(spawnRainbow); task.wait(rainbowDelay) end
        rainbowThread = nil
    end)
end
local function stopRainbow() autoRainbow = false; if rainbowThread then task.cancel(rainbowThread); rainbowThread = nil end end

