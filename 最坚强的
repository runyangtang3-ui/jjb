local function findHubGui()
    local function scan(container)
        for _, obj in ipairs(container:GetChildren()) do
            if obj:IsA("ScreenGui") then
                local hit = false
                if tostring(obj.Name):lower():find("obsidian") then hit = true end
                if not hit then
                    for _, desc in ipairs(obj:GetDescendants()) do
                        if desc:IsA("TextLabel") and tostring(desc.Text):find("红星") then hit = true break end
                    end
                end
                if hit then return obj end
            end
        end
    end
    local g = scan(game:GetService("CoreGui"))
    if g then return g end
    return scan(game.Players.LocalPlayer:FindFirstChild("PlayerGui"))
end

